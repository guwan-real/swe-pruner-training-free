# Copy this file to zero_forward_server_profile.env in the repository root.
# That destination is ignored by Git. Replace paths with server-local values.

ENV_NAME=swepruner-training-free
BASE_DIR=/home/yuantao/futao
VLLM_API_BASE=http://127.0.0.1:8015/v1

# Python from the existing mini-swe-agent install. The launcher uses this
# interpreter directly and does not reinstall or copy mini-swe-agent.
MINI_SWE_PYTHON=/absolute/path/to/mini-swe-agent-venv/bin/python
# Optional: leave unset to auto-discover extra/benchmarks/swebench.yaml from
# that exact mini installation.
# MINI_SWE_BASE_CONFIG=/absolute/path/to/mini-swe-agent/swebench.yaml

# Optional if model auto-discovery from /v1/models is not desired.
# VLLM_MODEL_ID=Qwen3.5-27B

TASK_SLICE=0:10
AGENT_WORKERS=1
PARALLEL_ARMS=1

# baseline + these four zero-LLM-call methods = five experiment arms.
METHODS=safe_rules,intent_ir,intent_structure,adaptive_evidence

# Required by the official /prune contract. adaptive_evidence does not use it
# to search keep ratios; intent_ir and intent_structure use it as one ablation budget.
PRUNING_THRESHOLD=0.5

# Client and cost gates. Long output is returned unchanged when a gate fails.
ZERO_FORWARD_MIN_CHARS=1000
ZERO_FORWARD_TIMEOUT=5
# Full recovery output above this limit is replaced by bounded rg/sed guidance
# so compact and recovered copies cannot both persist in every later prompt.
ZERO_FORWARD_RECOVERY_MAX_CHARS=3000
MIN_INPUT_TOKENS=1500
MIN_SAVINGS_TOKENS=256
MAX_RETENTION_RATIO=0.85
MAX_CPU_MS=50
# Keep the compacted payload below standard mini-swe-agent's 10k-char
# observation display limit so selected middle evidence is not clipped again.
MAX_OUTPUT_CHARS=9000
RAW_TTL_HOURS=72
MIN_FREE_DISK_GB=10

# Optional Python environment containing the official SWE-Bench harness.
# SWEBENCH_PYTHON=/absolute/path/to/swebench-venv/bin/python
