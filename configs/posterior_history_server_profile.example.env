# Copy to posterior_history_server_profile.env in the repository root.
# This experiment is isolated from zero_forward_server_profile.env.

ENV_NAME=swepruner-training-free
BASE_DIR=/home/yuantao/futao
VLLM_API_BASE=http://127.0.0.1:8015/v1
MINI_SWE_PYTHON=/absolute/path/to/mini-swe-agent-venv/bin/python
# MINI_SWE_BASE_CONFIG=/absolute/path/to/mini-swe-agent/swebench.yaml
# VLLM_MODEL_ID=Qwen3.5-27B
# SWEBENCH_PYTHON=/absolute/path/to/swebench-venv/bin/python

# Keep sequential for meaningful vLLM wall-time comparisons.
PARALLEL_ARMS=0
TASK_SLICE=0:5
AGENT_WORKERS=1
GRADER_WORKERS=4

# baseline + posterior_adaptive by default. Add `safe` only after replay.
POSTERIOR_HISTORY_METHODS=adaptive
POSTERIOR_HOT_OBSERVATIONS=2
POSTERIOR_MIN_INPUT_TOKENS=1500
POSTERIOR_MIN_SAVINGS_TOKENS=256
POSTERIOR_MAX_RETENTION_RATIO=0.85
POSTERIOR_BLOCK_MAX_LINES=16
POSTERIOR_MAX_OUTPUT_CHARS=9000
MIN_FREE_DISK_GB=10
