# Copy to agent_context_server_profile.env in the repository root.

ENV_NAME=swepruner-training-free
BASE_DIR=/home/yuantao/futao
VLLM_API_BASE=http://127.0.0.1:8015/v1
# Preflight requires this endpoint; prefix-cache counters are reported when available.
VLLM_METRICS_URL=http://127.0.0.1:8015/metrics
# Every arm starts from an empty vLLM prefix cache for order-independent metrics.
VLLM_RESET_PREFIX_CACHE_URL=http://127.0.0.1:8015/reset_prefix_cache
MINI_SWE_PYTHON=/absolute/path/to/mini-swe-agent-venv/bin/python
# MINI_SWE_BASE_CONFIG=/absolute/path/to/mini-swe-agent/swebench.yaml
# VLLM_MODEL_ID=Qwen3.5-27B
# SWEBENCH_PYTHON=/absolute/path/to/swebench-venv/bin/python
# Optional consistency assertion; it must match DATASET_SUBSET.
# SWEBENCH_DATASET_NAME=princeton-nlp/SWE-bench_Verified

# Run arms sequentially for meaningful KV-cache and wall-time comparisons.
PARALLEL_ARMS=0
DATASET_SUBSET=verified
DATASET_SPLIT=test
TASK_SLICE=0:30
# TASK_FILTER=
AGENT_WORKERS=1
AGENT_STEP_LIMIT=100
GRADER_WORKERS=4

# R/D/E/F/C are the requested pilot. F0 is an optional, meaningful typed
# signal ablation because legacy_posterior_v1 does not consume signal_strategy.
AGENT_CONTEXT_ARMS=R,D,E,F,C
AGENT_CONTEXT_ARM_CONFIG_DIR=configs/agent_context_server_arms
AGENT_CONTEXT_REFERENCE_ARM=R
# SMOKE_ARM=R

MIN_FREE_DISK_GB=10
