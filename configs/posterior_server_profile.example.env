# Copy this file to posterior_server_profile.env in the repository root.
# That destination is ignored by Git. Replace paths with server-local values.

ENV_NAME=swepruner-training-free
BASE_DIR=/home/yuantao/futao
VLLM_API_BASE=http://127.0.0.1:8015/v1

# Python from the existing mini-swe-agent install. The launcher uses this
# interpreter directly and does not reinstall or copy mini-swe-agent.
MINI_SWE_PYTHON=/absolute/path/to/mini-swe-agent-venv/bin/python
MINI_SWE_BASE_CONFIG=/absolute/path/to/mini-swe-agent/swebench.yaml

# Optional if model auto-discovery from /v1/models is not desired.
# VLLM_MODEL_ID=Qwen3.5-27B

TASK_SLICE=0:10
AGENT_WORKERS=1
KEEP_RATIO=0.5
PARALLEL_ARMS=1

# baseline + these four methods = five experiment arms.
METHODS=single_verify,budget_search,greedy_blocks,block_influence
MAX_MEAN_LOGPROB_DROP=0.08
MAX_POSTERIOR_EVALUATIONS=6
POSTERIOR_MIN_CHARS=500
POSTERIOR_TIMEOUT=180
MIN_FREE_DISK_GB=10

# Must match any non-default chat-template options used for the agent model.
# Example for a server/config that explicitly disables thinking:
# CHAT_TEMPLATE_KWARGS_JSON='{"enable_thinking":false}'
CHAT_TEMPLATE_KWARGS_JSON='{}'

# Optional Python environment containing the official SWE-Bench harness.
# SWEBENCH_PYTHON=/absolute/path/to/swebench-venv/bin/python
