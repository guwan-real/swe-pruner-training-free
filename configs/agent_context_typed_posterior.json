{
  "timing": "posterior",
  "hot_observations": 2,
  "codec_profile": "typed_v1",
  "signal_provider": "posterior_action",
  "signal_strategy": "rare_terms",
  "planner": {
    "mode": "retention",
    "cache_policy": "freeze_on_cold",
    "target_retention": 0.6,
    "recency_weight": 1.0,
    "relevance_weight": 2.0,
    "kind_weights": {
      "traceback": 1.5,
      "test_log": 1.5,
      "source": 1.2,
      "search": 1.0,
      "tree": 0.8,
      "generic": 0.8
    }
  },
  "views": {
    "include_reference_view": false,
    "include_skeleton_view": true,
    "include_focused_view": true,
    "max_output_chars": 9000
  },
  "view_overrides": {
    "source": {
      "focused_expansion_radius": 1
    },
    "traceback": {
      "focused_expansion_radius": 2
    },
    "test_log": {
      "focused_expansion_radius": 2
    },
    "search": {
      "focused_expansion_radius": 0
    },
    "tree": {
      "focused_expansion_radius": 0
    }
  },
  "codec_options": {
    "block_max_lines": 16
  },
  "signal_options": {
    "max_document_frequency_ratio": 0.1
  },
  "include_task_signal": false,
  "include_causing_action_signal": false,
  "track_later_references": true
}
