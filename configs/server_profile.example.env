# Copy this file to server_profile.env in the repository root and replace only
# paths that differ on the server. server_profile.env is ignored by Git.

ENV_NAME=swepruner-training-free
VLLM_API_BASE=http://127.0.0.1:8015/v1

# Existing pruning-capable mini-swe-agent installation. It may remain in a
# separate uv/venv; do not reinstall it into this repository's conda env.
MINI_EXTRA_BIN=/absolute/path/to/mini-swe-agent-venv/bin/mini-extra
MINI_SWE_PYTHON=/absolute/path/to/mini-swe-agent-venv/bin/python
MINI_SWE_AGENT_ROOT=/absolute/path/to/mini-swe-agent--with-pruning
MINI_SWE_BASE_CONFIG=/absolute/path/to/pruning-template.yaml

# Optional: only needed when the official grader is installed in a third env.
SWEBENCH_PYTHON=/absolute/path/to/swebench-venv/bin/python

# Smoke can proceed with 10GB free, but the launcher warns below 50GB because
# Docker images for larger SWE-Bench slices can consume much more.
MIN_FREE_DISK_GB=10
WARN_FREE_DISK_GB=50
